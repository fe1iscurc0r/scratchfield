{
  "name": "chembl",
  "displayName": "ChEMBL 生物活性分子库",
  "version": "1.0.0",
  "description": "欧洲生物活性分子库：化合物搜索/靶点信息/活性数据/结构获取/相似度搜索/批次下载（在线 EBI REST）",
  "author": "陆墨助手",
  "license": "Apache-2.0",
  "agentType": "mcp",
  "entryPoint": {
    "module": "mcpserver.chembl.agent",
    "class": "ChEMBLAgent"
  },
  "capabilities": {
    "invocationCommands": [
      {
        "command": "chembl_search_compound",
        "description": "按名称/前缀搜索 ChEMBL 化合物（支持 CHEMBL 编号直达）",
        "params": {
          "query": "化合物名称或前缀，如 'aspirin'；若以 CHEMBL 开头则按编号直达",
          "limit": "返回条数（默认 5，上限 20）"
        },
        "example": "{\"tool_name\":\"chembl_search_compound\",\"query\":\"aspirin\",\"limit\":5}"
      },
      {
        "command": "chembl_target",
        "description": "靶点信息：CHEMBL 靶点编号 → 名称/物种/类型/蛋白组件",
        "params": {
          "target_id": "靶点 CHEMBL 编号，如 'CHEMBL2368546'"
        },
        "example": "{\"tool_name\":\"chembl_target\",\"target_id\":\"CHEMBL2368546\"}"
      },
      {
        "command": "chembl_activity",
        "description": "活性数据：分子 CHEMBL 编号 → 相关 assay 活性测定（IC50/EC50 等）",
        "params": {
          "chembl_id": "分子 CHEMBL 编号，如 'CHEMBL25'",
          "limit": "返回条数（默认 10，上限 100）"
        },
        "example": "{\"tool_name\":\"chembl_activity\",\"chembl_id\":\"CHEMBL25\",\"limit\":10}"
      },
      {
        "command": "chembl_structure",
        "description": "结构获取：分子 CHEMBL 编号 → canonical SMILES + molfile",
        "params": {
          "chembl_id": "分子 CHEMBL 编号，如 'CHEMBL25'"
        },
        "example": "{\"tool_name\":\"chembl_structure\",\"chembl_id\":\"CHEMBL25\"}"
      },
      {
        "command": "chembl_similarity",
        "description": "相似度搜索：SMILES → 相似分子列表（Tanimoto 阈值）",
        "params": {
          "smiles": "查询分子 SMILES（必填）",
          "similarity": "相似度阈值 0-100（默认 90）",
          "limit": "返回条数（默认 5，上限 20）"
        },
        "example": "{\"tool_name\":\"chembl_similarity\",\"smiles\":\"CC(=O)Oc1ccccc1C(=O)O\",\"similarity\":95,\"limit\":5}"
      },
      {
        "command": "chembl_batch",
        "description": "批次下载：多个分子 CHEMBL 编号批量拉取（上限 50）",
        "params": {
          "chembl_ids": "CHEMBL 编号数组，如 [\"CHEMBL25\",\"CHEMBL26\"]；也接受逗号分隔字符串"
        },
        "example": "{\"tool_name\":\"chembl_batch\",\"chembl_ids\":[\"CHEMBL25\",\"CHEMBL26\"]}"
      }
    ]
  }
}
