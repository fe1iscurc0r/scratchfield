{
  "name": "material_science",
  "displayName": "材料科研助手",
  "version": "1.0.0",
  "description": "材料科研专用工具集：文献检索、配方查询、属性计算、相图分析、晶体结构查询、热分析、材料对比",
  "author": "陆墨助手",
  "agentType": "mcp",
  "entryPoint": {
    "module": "mcpserver.material_science.materialscience_agent",
    "class": "MaterialScienceAgent"
  },
  "capabilities": {
    "invocationCommands": [
      {
        "command": "literature_search",
        "description": "文献检索：在 RAG 知识库中检索材料科研相关文献",
        "params": {
          "query": "检索关键词",
          "max_results": "最大结果数（默认10）"
        },
        "example": "{\"tool_name\":\"literature_search\",\"query\":\"锂电池正极材料\", \"max_results\": 5}"
      },
      {
        "command": "formula_query",
        "description": "配方查询：查询材料配方和制备工艺",
        "params": {
          "material_type": "材料类型",
          "composition": "成分关键词（可选）",
          "method": "制备方法（可选）"
        },
        "example": "{\"tool_name\":\"formula_query\",\"material_type\":\"锂电三元\"}"
      },
      {
        "command": "property_calc",
        "description": "属性计算：计算材料物理化学属性",
        "params": {
          "calc_type": "计算类型（density/hardness/melting_point/conductivity/band_gap）",
          "composition": "材料名称或化学式",
          "temperature": "温度（摄氏度，可选，默认25）"
        },
        "example": "{\"tool_name\":\"property_calc\",\"calc_type\":\"density\",\"composition\":\"LiCoO2\"}"
      },
      {
        "command": "phase_diagram",
        "description": "相图查询：查询二元/三元相图信息",
        "params": {
          "elements": "元素列表",
          "temperature": "温度范围（可选）"
        },
        "example": "{\"tool_name\":\"phase_diagram\",\"elements\":[\"Fe\",\"C\"]}"
      },
      {
        "command": "crystal_info",
        "description": "晶体结构查询：查询材料晶体结构信息",
        "params": {
          "material": "材料名称或化学式",
          "crystal_system": "晶系（可选）"
        },
        "example": "{\"tool_name\":\"crystal_info\",\"material\":\"LiFePO4\"}"
      },
      {
        "command": "thermal_analysis",
        "description": "热分析计算：DSC/TGA 曲线分析",
        "params": {
          "analysis_type": "分析类型（dsc/tga/dta）",
          "material": "材料名称",
          "heating_rate": "升温速率（℃/min）"
        },
        "example": "{\"tool_name\":\"thermal_analysis\",\"analysis_type\":\"dsc\",\"material\":\"LiCoO2\",\"heating_rate\":10}"
      },
      {
        "command": "material_compare",
        "description": "材料对比：对比两种材料的属性",
        "params": {
          "material_a": "材料A名称",
          "material_b": "材料B名称",
          "properties": "对比属性列表"
        },
        "example": "{\"tool_name\":\"material_compare\",\"material_a\":\"LiCoO2\",\"material_b\":\"LiFePO4\"}"
      },
      {
        "command": "matchat_search",
        "description": "MatChat 文献检索：通过 MatChat 2.0 AI 搜索材料科学文献（松山湖材料实验室 28万篇论文知识库）",
        "params": {
          "query": "搜索关键词（必填）",
          "max_results": "返回结果数（默认5）"
        },
        "example": "{\"tool_name\":\"matchat_search\",\"query\":\"lignin carbonization\",\"max_results\":3}"
      },
      {
        "command": "matchat_chat",
        "description": "MatChat AI 对话：与 MatChat 2.0 讨论材料合成路径、性能对比、配方优化",
        "params": {
          "message": "对话内容（必填）"
        },
        "example": "{\"tool_name\":\"matchat_chat\",\"message\":\"如何优化木质素基碳材料的电导率？\"}"
      },
      {
        "command": "matchat_extract",
        "description": "MatChat 页面提取：提取当前 MatChat 页面的对话文本",
        "params": {},
        "example": "{\"tool_name\":\"matchat_extract\"}"
      },
      {
        "command": "matchat_login_check",
        "description": "MatChat 登录状态检查：返回是否需要登录、当前页面 URL 等信息",
        "params": {},
        "example": "{\"tool_name\":\"matchat_login_check\"}"
      },
      {
        "command": "biopred_predict",
        "description": "ML 预测：基于实验参数（前驱体/KOH 比/碳化温度/保温时间）预测导电率并给出置信区间",
        "params": {
          "desc": "参数描述，如 '秸秆+KOH 800°C' 或 JSON",
          "db_path": "数据集路径（默认 carbonization.db）"
        },
        "example": "{\"tool_name\":\"biopred_predict\",\"desc\":\"秸秆+KOH 800°C\"}"
      },
      {
        "command": "biopred_suggest",
        "description": "主动学习：建议下一组最有信息量的实验参数组合",
        "params": {
          "db_path": "数据集路径（默认 carbonization.db）",
          "target": "预测目标（默认 conductivity）"
        },
        "example": "{\"tool_name\":\"biopred_suggest\"}"
      }
    ]
  }
}
