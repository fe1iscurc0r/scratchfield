{
  "name": "rf_brain",
  "displayName": "射频大脑",
  "version": "1.0.0",
  "description": "物理层 AI 决策大脑：频谱感知→特征提取→LLM决策(调制方式/解调参数)→解调→反馈迭代闭环。协议无关抽象层，M1 仿真数据源，M2 接真 SDR",
  "author": "实验田维护者",
  "agentType": "mcp",
  "entryPoint": {
    "module": "mcpserver.rf_brain.agent",
    "class": "RfBrainAgent"
  },
  "capabilities": {
    "invocationCommands": [
      {
        "command": "analyze_signal",
        "description": "分析一路 IQ 信号：感知→决策→解调闭环，返回调制方式与收敛结果",
        "params": {
          "iq": "复数 IQ 样本数组",
          "sample_rate": "采样率 Hz",
          "center_freq": "中心频率 Hz"
        },
        "example": "{\"tool_name\":\"analyze_signal\",\"sample_rate\":2000000,\"center_freq\":433920000}"
      },
      {
        "command": "generate_and_analyze",
        "description": "合成一路调制信号并跑闭环（M1 自测用）",
        "params": {
          "modulation": "GFSK/FSK/OOK",
          "sample_rate": "采样率 Hz",
          "snr_db": "信噪比 dB"
        },
        "example": "{\"tool_name\":\"generate_and_analyze\",\"modulation\":\"GFSK\",\"snr_db\":20}"
      },
      {
        "command": "sentinel_ingest",
        "description": "收一条边缘哨兵 NDJSON 上报入记忆库（坏 JSON/未知协议/缺字段降级跳过，不崩）",
        "params": {
          "line": "NDJSON 单行字符串（或 data 直接传对象）"
        },
        "example": "{\"tool_name\":\"sentinel_ingest\",\"line\":\"{\\\"src\\\":\\\"sentinel\\\",\\\"protocol\\\":\\\"acurite\\\",\\\"id\\\":12345,\\\"channel\\\":\\\"B\\\",\\\"temperature\\\":21.5,\\\"humidity\\\":55,\\\"battery\\\":\\\"OK\\\",\\\"crc_ok\\\":true,\\\"rssi_dbm\\\":-60}\"}"
      },
      {
        "command": "sentinel_status",
        "description": "哨兵记忆库状态：总条数 + 最近 N 条上报",
        "params": {
          "limit": "最近条数（默认 10）"
        },
        "example": "{\"tool_name\":\"sentinel_status\",\"limit\":5}"
      },
      {
        "command": "sentinel_query",
        "description": "按协议/id 查哨兵上报（协议可省=全部，id 可省）",
        "params": {
          "protocol": "acurite/nexus/kerui（可省=全部）",
          "id": "传感器 id（可省）",
          "limit": "条数上限（默认 100）"
        },
        "example": "{\"tool_name\":\"sentinel_query\",\"protocol\":\"acurite\",\"id\":12345,\"limit\":20}"
      },
      {
        "command": "spectrum_events.ingest_frame",
        "description": "吞入一帧频谱（freqs/db），检测信号出现/消失/突发并缓存",
        "params": {
          "freqs": "频率数组 Hz",
          "db": "功率数组 dBm（与 freqs 等长）",
          "timestamp": "可选时间戳（默认 now）"
        },
        "example": "{\"tool_name\":\"spectrum_events.ingest_frame\",\"freqs\":[433900000,433920000],\"db\":[-50,-95]}"
      },
      {
        "command": "spectrum_events.current_interferers",
        "description": "当前活跃干扰源（未消失），按强度降序",
        "example": "{\"tool_name\":\"spectrum_events.current_interferers\"}"
      },
      {
        "command": "spectrum_events.recent_events",
        "description": "最近 n 条频谱事件（旧→新）",
        "params": {
          "limit": "条数（默认 10）"
        },
        "example": "{\"tool_name\":\"spectrum_events.recent_events\",\"limit\":10}"
      }
    ]
  },
  "classification": {
    "families": [
      "instrument"
    ],
    "domains": [
      "mechat"
    ],
    "tier": "process-control",
    "origin": {
      "kind": "native"
    }
  },
  "capability_pairs": [["analyze", "rf_signal"], ["compute", "rf_signal"], ["ingest", "rf_signal"], ["ingest", "sentinel"], ["list", "rf_signal"], ["lookup", "rf_signal"], ["search", "sentinel"], ["status", "sentinel"]]
}