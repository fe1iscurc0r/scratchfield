{
  "name": "agent_reach",
  "displayName": "多平台渠道状态",
  "version": "1.5.0",
  "description": "Agent-Reach 渠道安装与诊断（doctor）：列出哪些 channel 已装、可用。实际搜索动作需调用上游 channel 工具。",
  "author": "沈遥",
  "agentType": "mcp",
  "entryPoint": {
    "module": "mcpserver.adapters.flat_bridges",
    "class": "AgentReachBridge"
  },
  "capabilities": {
    "invocationCommands": [
      {
        "command": "agent_reach_status",
        "description": "Agent-Reach 渠道状态：哪些 channel 已安装、可用",
        "parameters": {
          "type": "object",
          "properties": {}
        },
        "example": "{\"tool_name\":\"agent_reach_status\"}"
      }
    ]
  },
  "classification": {
    "families": [
      "ecology"
    ],
    "domains": [],
    "tier": "read-only",
    "origin": {
      "kind": "bridge",
      "upstream": "Agent-Reach",
      "upstream_license": "见上游"
    }
  },
  "requires": {},
  "capability_pairs": [["status", "agent_reach"]]
}
