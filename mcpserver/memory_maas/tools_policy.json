{
  "version": 1,
  "description": "记忆实体类型 → 可流向工具白名单（流策略，参照 AgentFlow）。default_tools 兜底未列类型。",
  "default_tools": [
    "memory_search",
    "memory_query_filtered"
  ],
  "entities": {
    "decision": {
      "allow": ["memory_search", "memory_query_filtered", "memory_maintenance"],
      "deny": []
    },
    "insight": {
      "allow": ["memory_search", "memory_query_filtered"],
      "deny": []
    },
    "handoff": {
      "allow": ["memory_query_filtered"],
      "deny": ["memory_search"]
    },
    "note": {
      "allow": ["memory_search", "memory_query_filtered"],
      "deny": []
    }
  }
}
