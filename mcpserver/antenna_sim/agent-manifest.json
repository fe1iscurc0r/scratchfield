{
  "name": "antenna_sim",
  "displayName": "天线仿真（模型生成/执行/分析）",
  "version": "0.1.0",
  "description": "天线仿真管线：给天线类型/频率/尺寸 → 生成可跑模型（OpenEMS CSX XML + Python 脚本）→ 排队执行（本机 OpenEMS 或 Kali 桥）→ S11/方向图/增益分析与档案归档。首期支持 Moxon / Quad / 轴向模螺旋八木；OpenEMS 为外部工具链（GPL-3.0 独立进程），本模块不引其源码。",
  "author": "实验田维护者",
  "agentType": "mcp",
  "entryPoint": {
    "module": "mcpserver.antenna_sim.tools",
    "class": "AntennaSimBridge"
  },
  "capabilities": {
    "invocationCommands": [
      {
        "command": "gen_model",
        "description": "按天线类型/频率/尺寸生成可跑的 OpenEMS 模型文件（CSX XML + Python 脚本，含元信息头与网格假设）",
        "parameters": {
          "type": "object",
          "properties": {
            "antenna_type": {
              "type": "string",
              "description": "moxon / quad / helical_yagi（sierpinski 预留未实现）"
            },
            "freq_mhz": {
              "type": "number",
              "description": "工作频率 MHz"
            },
            "params": {
              "type": "object",
              "description": "尺寸参数（缺省按频率推默认值）；单位 mm，线径 wire_dia_mm"
            },
            "out_dir": {
              "type": "string",
              "description": "输出目录（默认 <user_data>/antenna-lab/models）"
            },
            "name": {
              "type": "string",
              "description": "文件名主干（默认 <type>_<freq>mhz）"
            }
          },
          "required": [
            "antenna_type",
            "freq_mhz"
          ]
        },
        "example": "{\"tool_name\":\"gen_model\",\"antenna_type\":\"moxon\",\"freq_mhz\":14.05}"
      },
      {
        "command": "sweep_params",
        "description": "参数扫描：对给定参数组合批量生成模型文件到批次目录，供排队执行",
        "parameters": {
          "type": "object",
          "properties": {
            "antenna_type": {
              "type": "string",
              "description": "moxon / quad / helical_yagi"
            },
            "freq_mhz": {
              "type": "number",
              "description": "工作频率 MHz"
            },
            "sweep": {
              "type": "object",
              "description": "参数 → 取值列表，如 {\"driven_len_mm\":[7000,7100],\"spacing_mm\":[1100,1200]}"
            },
            "out_dir": {
              "type": "string",
              "description": "批次输出目录"
            }
          },
          "required": [
            "antenna_type",
            "freq_mhz",
            "sweep"
          ]
        },
        "example": "{\"tool_name\":\"sweep_params\",\"antenna_type\":\"moxon\",\"freq_mhz\":14.05,\"sweep\":{\"driven_len_mm\":[7000,7100],\"spacing_mm\":[1100,1200]}}"
      },
      {
        "command": "sim_run",
        "description": "把一个模型排队跑起来（本机 OpenEMS 优先，其次 Kali 桥；dry-run 只走状态机不真跑）",
        "parameters": {
          "type": "object",
          "properties": {
            "model_path": {
              "type": "string",
              "description": "模型 XML/Python 路径（gen_model 的产物）"
            },
            "job_id": {
              "type": "string",
              "description": "自定义任务号（默认自动生成）"
            },
            "dry_run": {
              "type": "boolean",
              "description": "true=只走状态机与目录准备，不真跑求解"
            },
            "timeout_s": {
              "type": "number",
              "description": "单任务超时（默认 1800s）"
            }
          },
          "required": [
            "model_path"
          ]
        },
        "example": "{\"tool_name\":\"sim_run\",\"model_path\":\".../moxon_14mhz.xml\"}"
      },
      {
        "command": "job_status",
        "description": "查仿真任务状态（pending/pushed/running/done/failed）与结果目录",
        "parameters": {
          "type": "object",
          "properties": {
            "job_id": {
              "type": "string",
              "description": "任务号；留空列出最近任务"
            }
          }
        },
        "example": "{\"tool_name\":\"job_status\",\"job_id\":\"ant-20260918-001\"}"
      },
      {
        "command": "analyze_result",
        "description": "分析仿真结果：谐振频率 / S11 min / -10dB 带宽 / 增益，出 summary.json 与理论对照建议",
        "parameters": {
          "type": "object",
          "properties": {
            "job_id": {
              "type": "string",
              "description": "任务号"
            },
            "s11_csv": {
              "type": "string",
              "description": "可选：直接给 S11 数据 CSV 路径（无 OpenEMS 输出时用）"
            },
            "synthetic": {
              "type": "boolean",
              "description": "true=用合成 S11 数据跑通流程（会在报告里标注）"
            }
          }
        },
        "example": "{\"tool_name\":\"analyze_result\",\"job_id\":\"ant-20260918-001\"}"
      }
    ]
  },
  "runtime": {
    "openems_hint": "本机 Windows 版 OpenEMS 解压后设置 ANTENNA_SIM_OPENEMS_DIR 指向其 bin 目录",
    "license_note": "OpenEMS/CSXCAD 为 GPL-3.0 独立工具链，仅以外部进程 + 文件交互，不并入本仓代码"
  },
  "classification": {
    "families": [
      "instrument"
    ],
    "domains": [
      "mechat"
    ],
    "tier": "process-control",
    "origin": {
      "kind": "native"
    }
  },
  "capability_pairs": [["analyze", "antenna"], ["compute", "antenna"], ["exec", "antenna"], ["status", "antenna"]]
}
