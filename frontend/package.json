{
  "name": "lumo",
  "type": "module",
  "version": "5.2.5",
  "private": true,
  "main": "dist-electron/main.js",
  "scripts": {
    "lint": "node scripts/run-eslint.mjs",
    "lint:fix": "node scripts/run-eslint.mjs --fix",
    "test": "node --test --experimental-strip-types tests/*.test.ts",
    "test:unit": "vitest run",
    "test:unit:coverage": "vitest run --coverage",
    "dev": "vite",
    "dev:web": "npx cross-env WEB_ONLY=1 vite",
    "build": "node scripts/run-build.mjs",
    "preview": "vite preview",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux"
  },
  "dependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@primeuix/themes": "^3.0.1",
    "@types/d3": "^7.4.3",
    "@types/markdown-it": "^14.1.2",
    "@vueuse/core": "^14.2.0",
    "axios": "^1.20.0",
    "camelcase-keys": "^10.0.3",
    "d3": "^7.9.0",
    "dompurify": "^3.4.16",
    "electron-updater": "^6.7.3",
    "highlight.js": "^11.12.0",
    "iterator-helper": "^1.3.4",
    "lodash.isequal": "^4.5.0",
    "markdown-it": "^15.0.1",
    "pixi-live2d-display": "^0.4.0",
    "pixi.js": "^6.5.10",
    "primevue": "^5.0.2",
    "snakecase-keys": "^9.0.2",
    "vue": "^3.5.42",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@types/dompurify": "^3.0.5",
    "@types/node": "^24.10.1",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vitest/coverage-v8": "^4.1.11",
    "@vue/test-utils": "^2.5.0",
    "@vue/tsconfig": "^0.9.1",
    "cross-env": "^10.1.0",
    "electron": "^41.10.3",
    "electron-builder": "^26.7.0",
    "eslint": "^10.12.0",
    "jsdom": "^30.0.1",
    "typescript": "~5.9.3",
    "unocss": "^66.10.5",
    "vite": "^8.3.2",
    "vite-plugin-electron": "^1.1.2",
    "vite-plugin-electron-renderer": "^1.0.0",
    "vitest": "^5.0.3",
    "vue-tsc": "^3.3.11"
  },
  "overrides": {
    "gh-pages": "^5.0.0",
    "tar": "^7.5.21",
    "glob": "^10.5.0",
    "brace-expansion": "^5.0.12",
    "fast-uri": "^3.1.6",
    "@xmldom/xmldom": "^0.8.15",
    "js-yaml": "^4.3.2",
    "ip-address": "^10.3.1",
    "undici": "^8.9.0",
    "qs": "^6.16.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/fe1iscurc0r/scratchfield"
  }
}