# MCP Server 安全配置
# 复制此文件为 .env.local 并填入实际值，切勿提交到版本控制

# === MCP Server 安全配置 ===
MCP_API_KEY=change-me-to-a-random-32-char-string
MCP_RATE_LIMIT=100
MCP_RATE_WINDOW=60
MCP_CALLBACK_ALLOWED_SCHEMES=http,https

# === Adapter 启用开关（默认开，=0/false 禁用）===
ENABLE_ADAPTER_AGENT_REACH=1
ENABLE_ADAPTER_VULNCLAW=1
ENABLE_ADAPTER_MEMCLAW=1
ENABLE_ADAPTER_HEADROOM=1

# === MemClaw（跨 Agent 记忆总线）===
IS_STANDALONE=true                    # vendor 原生 env，必须 true 才走 SQLite 路径
ENVIRONMENT=development               # vendor 原生 env
MEMCLAW_DB_PATH=                      # 留空则自动用 data/memclaw/memclaw.db
MEMCLAW_OPENAI_API_KEY=               # 留空则降级为纯存储模式（不 enrich/embed）

# === VulnClaw（渗透测试编排，需合法授权）===
VULNCLAW_OPENAI_API_KEY=              # 留空则 healthcheck 失败跳过

# === 全局 LLM key（adapter fallback）===
OPENAI_API_KEY=

# === 安全工具路径（自动检测，一般无需修改）===
TRIVY_PATH=
SYFT_PATH=

# === lumo_fusion.ps1 工具链路径（issue #18；留空走脚本自动探测）===
LUMO_FUSION_PYTHON=            # Python 解释器绝对路径
LUMO_FUSION_NODE=              # node.exe 绝对路径
LUMO_FUSION_NEO4J_BAT=         # neo4j.bat 绝对路径（-NoNeo4j 时可不填）
LUMO_FUSION_JAVA_HOME=         # JDK 目录（-NoNeo4j 时可不填）

# === M4 CUA 执行桥（留空走自动生成/默认值）===
# NEKO_EXEC_TOKEN：陆墨 agent → NEKO CUA 执行桥凭证，lumo_fusion.ps1 / 后端启动时自动生成，
#   无需手动配置；手动固定时后端与 NEKO 必须用同一份。
#NEKO_EXEC_TOKEN=
# 视觉透传上游（lumo_proxy M4.5 节点，CUA 截图走这里；留空默认 dashscope + qwen3.7-plus，
#   凭证 fallback 读 NEKO 用户配置 core_config.json 的 coreApiKey）
#LUMO_VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#LUMO_VISION_MODEL=qwen3.7-plus
#LUMO_VISION_API_KEY=
COSIGN_PATH=
JADX_PATH=
NUCLEI_PATH=
SHERLOCK_PATH=

# === apiserver 配置（工单204 任务四；单一真源见 apiserver/config.py ENV_SPEC）===
API_SERVER_HOST=127.0.0.1   # API 服务监听地址（类型 str）
API_SERVER_PORT=   # API 服务端口（类型 int）
API_SERVER_RELOAD=False   # API 服务热重载（类型 bool）
LLM_SERVICE_HOST=127.0.0.1   # LLM 服务监听地址（类型 str）
LLM_SERVICE_PORT=   # LLM 服务端口（类型 int）
LLM_SERVICE_RELOAD=False   # LLM 服务热重载（类型 bool）
NEKO_AGENT_BASE=http://127.0.0.1:48915   # NEKO 桌宠壳 agent 端点（类型 str）
NEKO_EXEC_TOKEN=   # NEKO 桌宠壳执行令牌（类型 str）
LUMO_ENABLE_THINKING=1   # 思考链开关（=0 关闭）（类型 bool-ish）
LUMO_DB_BACKUP_DIR=   # 数据库备份根目录（类型 str）
USERNAME=   # 本机用户名（naga_auth）（类型 str）
LUMO_PROXY_TOKEN=   # NEKO 注入鉴权令牌（铁律7）（类型 str）
LUMO_VAULT_DIR=   # 凭据库目录（类型 str）
LUMO_VISION_API_KEY=   # 视觉模型 API key（类型 str）
LUMO_VISION_MODEL=   # 视觉模型名（类型 str）
SPECTRUM_SOURCE=   # 频谱数据源（类型 str）
ASR_API_URL=   # ASR 服务地址（类型 str）
ASR_MODEL=   # ASR 模型名（类型 str）
